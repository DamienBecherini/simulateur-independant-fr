# Fichier .gitignore pour un projet Node.js / Electron

# Dépendances
# Le dossier le plus important à ignorer. Il est généré par `npm install`.
node_modules/
.git/

# Fichiers de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dossiers de build
# Générés par Electron Builder lors du packaging de l'application.
dist/
out/
release/
build/

# Fichiers de l'éditeur de code
# Pour éviter de partager les préférences personnelles de VS Code.
.vscode/

# Fichiers système
.DS_Store
Thumbs.db