# Fichier .gitignore pour un projet Node.js / Electron

# Dépendances
node_modules/
node_modules*/
.git/

# Fichiers de log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules*
dist
dist-react
dist-web
dist-electron
*.local
# Ressources d'electron-builder : seules celles du paquet du Microsoft Store sont versionnées.
/build/*
!/build/appx/
!/build/store/

# Agrégat des retours des utilisateurs, produit à chaque publication de la démo web (scripts/retours/agreger.mjs)
public/retours.json

# Tests : couverture et tests de mutation (Stryker)
coverage
reports
.stryker-tmp
test-results
playwright-report

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
