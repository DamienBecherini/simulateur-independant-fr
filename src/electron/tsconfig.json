// src/electron/tsconfig.json

{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": "../../dist-electron",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  // On inclut explicitement tous les fichiers .ts du dossier
  // ET le fichier de déclarations globales.
  "include": ["./**/*", "../../types.d.ts"]
}
