// src/backend/tsconfig.json

{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": "../../dist-electron",
    "rootDir": "../",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../../",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Le process principal, les types communs et les canaux entre l'interface et le process principal.
  "include": ["./**/*", "../types.ts", "../globals.d.ts"],
  // Les tests ne sont pas embarqués dans l'application : ils sont vérifiés à part (tsconfig.test.json).
  "exclude": ["./**/*.test.ts", "./logic/testing/**"]
}
