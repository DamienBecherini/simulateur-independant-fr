{
  "appId": "fr.independant.simulateur",
  "productName": "Simulateur Indépendant FR",
  "copyright": "© Damien Becherini — licence MIT",
  "directories": {
    "output": "dist"
  },
  "artifactName": "Simulateur-Independant-FR-${version}-${os}-${arch}.${ext}",
  "files": [
    "dist-electron",
    "dist-react",
    "splash.html",
    "!dist-electron/mcp/**/*",
    "!dist-electron/backend/mcp/serveur*.js",
    "!dist-electron/backend/mcp/donnees.js",
    "!node_modules/**/*",
    "node_modules/zod/**/*",
    "!node_modules/zod/src/**/*",
    "!**/*.{map,ts,cts,mts}"
  ],
  "extraResources": [
    "dist-electron/backend/preload.cjs",
    {
      "from": "dist-electron/mcp/serveur-mcp.mjs",
      "to": "mcp/serveur-mcp.mjs"
    }
  ],
  "icon": "./templateIcon.png",
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "category": "public.app-category.finance",
    "identity": "-",
    "hardenedRuntime": false
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Office",
    "maintainer": "Damien Becherini <damien@becherini.fr>",
    "synopsis": "Simulateur hors-ligne pour indépendants français",
    "syncDesktopName": true
  },
  "win": {
    "target": [
      "nsis",
      "zip"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "appx": {
    "displayName": "Simulateur Indépendant FR",
    "applicationId": "SimulateurIndependantFR",
    "backgroundColor": "transparent",
    "languages": [
      "fr-FR"
    ],
    "minVersion": "10.0.17763.0",
    "maxVersionTested": "10.0.26100.0",
    "customExtensionsPath": "build/store/extensions-appx.xml",
    "artifactName": "Simulateur-Independant-FR-${version}-store-${arch}.${ext}"
  },
  "electronLanguages": [
    "fr",
    "en-US"
  ]
}
