{
  "name": "simulateur-independant-fr",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently -k --success first \"npm:dev:sass\" \"npm:dev:electron\"",
    "dev:sass": "sass --watch ui/scss:ui/css",
    "dev:electron": "electron .",
    "test": "jest",
    "concat": "node concat_code.js",
    "concat:stable": "node concat_code.js --no-timestamp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Un simulateur de revenus et de statut pour les travailleurs indépendants en France.",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-reloader": "^1.2.3",
    "globby": "^14.1.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "sass": "^1.92.1",
    "tree-node-cli": "^1.6.0"
  },
  "dependencies": {
    "showdown": "^2.1.0"
  }
}
