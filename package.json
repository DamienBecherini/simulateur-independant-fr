{
  "name": "simulateur-independant-fr",
  "private": true,
  "version": "0.9.0",
  "description": "Simulateur desktop hors-ligne pour indépendants français : statuts juridiques, cotisations, impôt du foyer et comparateur de statuts.",
  "author": "Damien Becherini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DamienBecherini/simulateur-independant-fr.git"
  },
  "type": "module",
  "main": "dist-electron/backend/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel --race dev:react dev:electron",
    "dev:react": "vite",
    "dev:web": "vite --mode web",
    "dev:electron": "wait-on http://localhost:3524 && npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "duplication": "jscpd src --min-tokens 70 --threshold 5 --ignore \"**/*.test.ts,**/*.test.tsx,src/components/ui/**,src/backend/logic/testing/**\" --reporters console",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && npm run build && playwright test",
    "test:e2e:visible": "cross-env E2E_VISIBLE=1 npm run test:e2e",
    "test:web": "vite build --mode web && playwright test --config playwright.web.config.ts",
    "test:all": "npm run test:coverage && npm run test:e2e && npm run test:web",
    "build:web": "vite build --mode web",
    "captures": "npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && npm run build && playwright test --config playwright.captures.config.ts",
    "test:mutation": "stryker run",
    "typecheck:tests": "tsc --project src/backend/tsconfig.test.json",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/backend/tsconfig.json",
    "dist:mac": "npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run transpile:electron && tsc-alias -p src/backend/tsconfig.json && npm run build && electron-builder --linux --x64",
    "concat": "node concat_code.cjs",
    "concat:stable": "node concat_code.cjs --no-timestamp"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "tailwindcss-animate": "^1.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/os-utils": "^0.0.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "globby": "^14.1.0",
    "jscpd": "^4.3.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  }
}
